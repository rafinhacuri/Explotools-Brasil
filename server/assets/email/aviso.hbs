<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{titulo}}</title>
</head>
<body style="margin:0;padding:0;background:#f1f1f2;">
<div style="display:none;max-height:0;overflow:hidden;">{{resumo}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f1f1f2;">
  <tr><td align="center" style="padding:24px 12px;">
    <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#ffffff;">
      <tr><td style="background:#0a0a0b;padding:20px 28px;border-top:5px solid #fe0018;font-family:Arial,Helvetica,sans-serif;font-size:13px;letter-spacing:2px;color:#ffffff;">
        <b>EXPLOTOOLS</b> <span style="color:#9a9a9f;text-transform:uppercase;">&nbsp;|&nbsp; {{evento}}</span>
      </td></tr>
      <tr><td style="padding:28px 28px 4px;font-family:Arial,Helvetica,sans-serif;font-size:22px;line-height:28px;font-weight:bold;color:#0a0a0b;">{{titulo}}</td></tr>
      <tr><td style="padding:0 28px 18px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:21px;color:#5c5c62;">{{resumo}}</td></tr>
      <tr><td style="padding:0 28px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:20px;">
          {{#each campos}}
          <tr>
            <td width="36%" style="padding:9px 0;border-bottom:1px solid #e6e6e8;color:#77777d;">{{rotulo}}</td>
            <td style="padding:9px 0;border-bottom:1px solid #e6e6e8;color:#0a0a0b;font-weight:bold;">{{valor}}</td>
          </tr>
          {{/each}}
        </table>
      </td></tr>
      <tr><td style="padding:24px 28px 30px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
          {{#if whatsapp}}
          <td style="background:#fe0018;padding:12px 20px;"><a href="{{whatsapp}}" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#ffffff;text-decoration:none;">Chamar no WhatsApp</a></td>
          <td width="10"></td>
          {{/if}}
          <td style="border:1px solid #0a0a0b;padding:11px 19px;"><a href="{{link}}" style="font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:bold;color:#0a0a0b;text-decoration:none;">{{botao}}</a></td>
        </tr></table>
      </td></tr>
      <tr><td style="background:#f7f7f8;padding:14px 28px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;color:#8a8a90;">
        Aviso automático do site explotools.com.br · {{data}}<br>Contém dados de cliente: uso interno da Explotools.
      </td></tr>
    </table>
  </td></tr>
</table>
</body>
</html>
